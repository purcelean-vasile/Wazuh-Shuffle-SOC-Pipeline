<!-- ###################################### -->
<!-- # Shuffle Active Response Quarantine # -->
<!-- ###################################### -->

<decoder name="shuffle_active_response_quarantine">
    <prematch>^QUARANTINE MALWARE STATUS</prematch>
</decoder>

<decoder name="shuffle_active_response_quarantine_fields">
    <parent>shuffle_active_response_quarantine</parent>
    <regex type="pcre2">QUARANTINE MALWARE STATUS (.+)</regex>
    <order>quarantine_malware_status</order>
</decoder>