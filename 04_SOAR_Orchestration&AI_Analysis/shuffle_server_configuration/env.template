# Orborus/Proxy configurations
# Proxy settings - Replace <docker_subnet> with your actual Docker bridge subnet (e.g., 172.20.0.0/24)
HTTP_PROXY=http://IP_PROXY:PORT
HTTPS_PROXY=http://IP_PROXY:PORT
NO_PROXY=localhost,127.0.0.1,shuffle-frontend,shuffle-backend,shuffle-orborus,shuffle-opensearch,ollama,<docker_subnet>
http_proxy=http://IP_PROXY:PORT
https_proxy=http://IP_PROXY:PORT
no_proxy=localhost,127.0.0.1,shuffle-frontend,shuffle-backend,shuffle-orborus,shuffle-opensearch,ollama,<docker_subnet>
SHUFFLE_PASS_WORKER_PROXY=TRUE
SHUFFLE_PASS_APP_PROXY=TRUE
SHUFFLE_INTERNAL_HTTP_PROXY=noproxy
SHUFFLE_INTERNAL_HTTPS_PROXY=noproxy
